[Unit]
Description=zmanim-sky-server: download the latest GFS ensemble (GEFS) run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=zmanim-sky
WorkingDirectory=/opt/zmanim-sky-server
Environment=ZMANIM_SKY_CONFIG=/opt/zmanim-sky-server/config.json
ExecStart=/opt/zmanim-sky-server/venv/bin/python fetch_gefs.py
# ~1250 requests per region with a polite delay between them
TimeoutStartSec=4h
Nice=10
