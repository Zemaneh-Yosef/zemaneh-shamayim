[Unit]
Description=zmanim-sky-server API
After=network.target

[Service]
User=zmanim-sky
WorkingDirectory=/opt/zmanim-sky-server
Environment=ZMANIM_SKY_CONFIG=/opt/zmanim-sky-server/config.json
ExecStart=/opt/zmanim-sky-server/venv/bin/python serve.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
